# Base URL of the Neta360 backend (FastAPI). Leave empty to run the demo form without a backend.
VITE_API_URL=

# Optional, used only when VITE_API_URL is empty: a Web3Forms access key (https://web3forms.com).
# Each demo request is then emailed to the address the key was created with.
VITE_WEB3FORMS_KEY=

# Optional, no signup needed: demo requests are emailed to this address via FormSubmit (https://formsubmit.co).
# The first submission sends an activation email to this address; click the link in it once.
VITE_DEMO_EMAIL=

# Optional: WhatsApp number that receives demo requests (country code + number, digits only, e.g. 919876543210).
# After submitting, the success screen shows a button that opens WhatsApp with the request pre-typed to this number.
VITE_WHATSAPP_NUMBER=

# Optional: CallMeBot API key (https://www.callmebot.com). When set together with VITE_WHATSAPP_NUMBER,
# each demo request is also sent automatically to that WhatsApp number (it must be the number that got the key).
VITE_CALLMEBOT_KEY=
